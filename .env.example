# Application
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
ALLOWED_HOSTS=
MCP_PUBLIC_BASE_URL=
MCP_MAX_UPLOAD_BYTES=20971520
METADATA_HTTP_TIMEOUT=5

# Database
AGENTSYS_DB_ENGINE=postgresql
AGENTSYS_DB_NAME=agentsys
AGENTSYS_DB_USER=agentsys_app
AGENTSYS_DB_PASSWORD=
AGENTSYS_DB_HOST=127.0.0.1
AGENTSYS_DB_PORT=5432

# Literature object storage (new uploads default to NAS; keep NJU Box for legacy records)
LITERATURE_STORAGE_BACKEND=nas_webdav
NAS_WEBDAV_BASE_URL=https://nas.example.edu:5006
NAS_WEBDAV_USERNAME=
NAS_WEBDAV_PASSWORD=
NAS_WEBDAV_LITERATURE_ROOT=/public/PLAB_KnowledgeBase/Literature
NAS_WEBDAV_SKILLS_ROOT=/public/PLAB_KnowledgeBase/Skills
NAS_WEBDAV_SKILL_CANDIDATES_ROOT=/public/PLAB_KnowledgeBase/SkillCandidates
LITERATURE_DOWNLOAD_LINK_MAX_AGE=300

# NJU Box target (credentials are entered per upload and are never stored)
NJU_BOX_API_URL=https://box.nju.edu.cn
NJU_BOX_REPOSITORY_ID=e2304051-022d-43bd-b3f9-d4d34051a040
NJU_BOX_TARGET_DIRECTORY=/
NJU_BOX_API_TOKEN=
NJU_BOX_LIBRARY_PASSWORD=
NJU_SKILLS_REPOSITORY_ID=
NJU_SKILLS_LIBRARY_PASSWORD=
NJU_SKILLS_TARGET_DIRECTORY=/
SKILL_DOWNLOAD_LINK_MAX_AGE=300
SKILL_JOB_STALE_SECONDS=3600

# Literature metadata providers (Zotero API keys are entered per import and never stored)
DOI_RESOLVER_URL=https://doi.org
CROSSREF_API_URL=https://api.crossref.org
CROSSREF_MAILTO=
ZOTERO_API_URL=https://api.zotero.org

# External AI provider
AI_API_KEY=

# DeepSeek metadata proposal provider (server-side only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
