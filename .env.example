# Application
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8001
MCP_MAX_UPLOAD_BYTES=104857600
METADATA_HTTP_TIMEOUT=15

# Database
AGENTSYS_DB_ENGINE=sqlite
AGENTSYS_DB_NAME=agentsys
AGENTSYS_DB_USER=agentsys_app
AGENTSYS_DB_PASSWORD=
AGENTSYS_DB_HOST=127.0.0.1
AGENTSYS_DB_PORT=5432

# Literature object storage
LITERATURE_STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=E:\Personal-Library\data
NAS_WEBDAV_BASE_URL=https://nas.example.edu:5006
NAS_WEBDAV_USERNAME=
NAS_WEBDAV_PASSWORD=
NAS_WEBDAV_LITERATURE_ROOT=/public/PLAB_KnowledgeBase/Literature
NAS_WEBDAV_SKILLS_ROOT=/public/PLAB_KnowledgeBase/Skills
NAS_WEBDAV_SKILL_CANDIDATES_ROOT=/public/PLAB_KnowledgeBase/SkillCandidates
LITERATURE_DOWNLOAD_LINK_MAX_AGE=300

SKILL_DOWNLOAD_LINK_MAX_AGE=300
SKILL_JOB_STALE_SECONDS=3600

# GitHub public Skill discovery (server-side token; do not grant private repository access)
GITHUB_API_TOKEN=

# Literature metadata providers (saved Zotero API keys are encrypted and never shown again)
DOI_RESOLVER_URL=https://doi.org
CROSSREF_API_URL=https://api.crossref.org
CROSSREF_MAILTO=
ZOTERO_API_URL=https://api.zotero.org

# External AI provider
AI_API_KEY=

# Paper Intelligence OpenAI-compatible provider (server-side only)
PAPER_LLM_BASE_URL=https://api.example.com/v1
PAPER_LLM_API_KEY=
PAPER_CHAT_MODEL=
PAPER_OVERVIEW_MODEL=
PAPER_VISION_MODEL=
PAPER_LLM_TIMEOUT=30
PAPER_LLM_RETRIES=1
PAPER_LLM_JSON_MODE=true
PAPER_LLM_VISION_ENABLED=true
PAPER_LLM_STREAMING_ENABLED=false

# DeepSeek metadata proposal provider (server-side only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30

# MinerU official cloud parser (create token at https://mineru.net/apiManage)
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=
# Dedicated worker-pool tokens. Realtime falls back to MINERU_API_TOKEN when empty.
MINERU_REALTIME_API_TOKEN=
MINERU_BACKFILL_API_TOKEN_1=
MINERU_BACKFILL_API_TOKEN_2=
MINERU_BACKFILL_API_TOKEN_3=
MINERU_BACKFILL_API_TOKEN_4=
MINERU_MODEL_VERSION=vlm
MINERU_REQUEST_TIMEOUT=120
MINERU_POLL_INTERVAL=5
MINERU_POLL_TIMEOUT=3600
MINERU_SEGMENT_PAGES=200
MINERU_RESULT_MAX_BYTES=838860800
